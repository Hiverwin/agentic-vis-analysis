{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visagentbench.dev/schema/benchmark.schema.json",
  "title": "VisAgentBench v2 Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "task_type",
    "widget_kind",
    "question_set",
    "data_source",
    "materializations",
    "benchmark_partition"
  ],
  "properties": {
    "benchmark_id": { "type": "string" },
    "task_type": { "type": "string" },
    "widget_kind": {
      "type": "string",
      "enum": ["bar", "line", "scatter", "parallelCoordinates", "sankey", "heatmap", "custom"]
    },
    "question_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["qid", "question", "question_style", "ground_truth"],
        "properties": {
          "qid": { "type": "string" },
          "question": { "type": "string" },
          "question_style": {
            "type": "string",
            "enum": ["natural_language", "tool_hinted"]
          },
          "ground_truth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_type",
              "answer",
              "key_insights",
              "reasoning_trace",
              "required_capabilities",
              "required_perceptions",
              "capability_param_checks",
              "canonical_state_checks",
              "renderer_state_checks",
              "state_check_fields"
            ],
            "properties": {
              "task_type": { "type": "string" },
              "answer": {
                "type": "object",
                "additionalProperties": true
              },
              "key_insights": {
                "type": "array",
                "items": { "type": "string" }
              },
              "reasoning_trace": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["iteration", "capability", "rationale"],
                  "properties": {
                    "iteration": { "type": ["integer", "null"] },
                    "capability": { "type": ["string", "null"] },
                    "rationale": { "type": "string" }
                  }
                }
              },
              "required_capabilities": {
                "type": "array",
                "items": { "type": "string" }
              },
              "required_perceptions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "capability_param_checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["capability", "param_eval"],
                  "properties": {
                    "capability": { "type": "string" },
                    "param_eval": { "type": "object", "additionalProperties": true }
                  }
                }
              },
              "canonical_state_checks": {
                "type": "object",
                "additionalProperties": true
              },
              "renderer_state_checks": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "state_check_fields": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dataset_id", "dataset_path", "row_count", "dataset_scale_tag"],
      "properties": {
        "kind": { "type": "string" },
        "dataset_id": { "type": ["string", "null"] },
        "dataset_path": { "type": ["string", "null"] },
        "row_count": { "type": ["integer", "null"] },
        "dataset_scale_tag": {
          "type": ["string", "null"],
          "enum": ["demo_tiny", "small", "medium", "large", "xlarge", "stress", null]
        }
      }
    },
    "materializations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "renderer-profile.schema.json#/$defs/materializationEntry"
      }
    },
    "benchmark_partition": {
      "type": "string",
      "enum": ["main", "hinted", "stress"]
    }
  }
}
