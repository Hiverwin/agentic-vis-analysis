{
  "name": "widgetva-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:extension": "npm run build:extension:early-capture && npm run build:extension:content && npm run build:extension:content:observable-d3 && npm run build:extension:content:observable-d3-worker && npm run build:extension:page && npm run build:extension:page:observable-d3 && cp extension/public/manifest.json extension/dist/manifest.json",
    "build:extension:early-capture": "vite build --config extension/vite.config.js --mode extension-early-capture",
    "build:extension:content": "vite build --config extension/vite.config.js --mode extension-content",
    "build:extension:content:observable-d3": "vite build --config extension/vite.config.js --mode extension-content-observable-d3",
    "build:extension:content:observable-d3-worker": "vite build --config extension/vite.config.js --mode extension-content-observable-d3-worker",
    "build:extension:page": "vite build --config extension/vite.config.js --mode extension-page",
    "build:extension:page:observable-d3": "vite build --config extension/vite.config.js --mode extension-page-observable-d3",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^8.0.16"
  }
}
