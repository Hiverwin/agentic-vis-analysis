  "question_set": [
    {
      "qid": "vm_02",
      "question": "What is the reliability of the trade-off between speed and quality?",
      "question_style": "natural_language",
      "ground_truth": {
        "task_type": "vague_multi",
        "answer": {
          "type": "open_ended",
          "value": "The haircare polylines cross freely—Pearson correlation between normalized lead time and defect rate is only about 0.03—so faster runs are not systematically cleaner or dirtier in this slice. You get a tangle of paths rather than a diagonal band, which means you should not infer a strong speed–quality trade-off from these two axes alone."
        },
        "key_insights": [
          "Lead time and defect rate do not line up as a simple inverse relationship here.",
          "After the category filter, every line is haircare, yet the spread across the two axes stays wide."
        ],
        "reasoning_trace": [
          {
            "iteration": 1,
            "capability": "parallel.dimensions.hide",
            "rationale": "Strips extra axes so lead time and defects can be compared directly."
          },
          {
            "iteration": 2,
            "capability": "data.filter.categorical",
            "rationale": "Keeps haircare lines to avoid mixing unrelated product physics."
          }
        ],
        "required_capabilities": [
          "parallel.dimensions.hide",
          "data.filter.categorical"
        ],
        "required_perceptions": [],
        "capability_param_checks": [
          {
            "capability": "parallel.dimensions.hide",
            "param_eval": {
              "type": "object",
              "param": "all_params",
              "target": {
                "mode": "hide",
                "dimensions": [
                  "Manufacturing costs",
                  "Production volumes"
                ]
              }
            }
          },
          {
