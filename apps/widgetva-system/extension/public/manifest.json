{
  "manifest_version": 3,
  "name": "WidgetVA Official Page Integration",
  "version": "0.1.0",
  "description": "Adds a user-triggered WidgetVA Dock to supported visualization pages.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "backgroundServiceWorker.js",
    "type": "module"
  },
  "action": {
    "default_title": "WidgetVA",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vega.github.io/vega-lite/examples/*"
      ],
      "js": [
        "officialVegaLiteEarlyCaptureContentScript.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://vega.github.io/vega-lite/examples/*"
      ],
      "js": [
        "officialVegaLiteContentScript.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://observablehq.com/@*/*"
      ],
      "js": [
        "observableD3ContentScript.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://observablehq.com/@*/*",
        "https://*.observableusercontent.com/*"
      ],
      "js": [
        "observableD3WorkerContentScript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "officialVegaLiteEarlyCaptureContentScript.js",
        "officialVegaLitePageScript.js",
        "observableD3PageScript.js"
      ],
      "matches": [
        "https://vega.github.io/*",
        "https://observablehq.com/*"
      ]
    }
  ]
}
